  "type": "object",
  "required": [
    "route",
    "productFamily",
    "mode",
    "designCognition",
    "layoutFingerprint",
    "simulationVerdict",
    "layoutAuditStatus",
    "designSystemRequirement",
    "craftScope"
  ],
  "properties": {
    "route": {"type": "string"},
    "productFamily": {"type": "string"},
    "mode": {"type": "string"},
    "designCognition": {"type": "object"},
    "layoutFingerprint": {"type": "object"},
    "simulationVerdict": {"type": "object"},
    "layoutAuditStatus": {"type": "string"},
    "designSystemRequirement": {"type": "object"},
    "craftScope": {"type": ["array", "string"]},
    "proposedOverrides": {"type": "object"}
  }
}

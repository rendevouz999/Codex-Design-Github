{
  "DesignHookDecision": {
    "additionalProperties": false,
    "properties": {
      "eligible": {
        "title": "Eligible",
        "type": "boolean"
      },
      "reason": {
        "title": "Reason",
        "type": "string"
      },
      "task_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Task Id"
      },
      "profile": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Profile"
      },
      "duplicate": {
        "default": false,
        "title": "Duplicate",
        "type": "boolean"
      }
    },
    "required": [
      "eligible",
      "reason"
    ],
    "title": "DesignHookDecision",
    "type": "object"
  },
  "DesignTask": {
    "$defs": {
      "ApprovalPolicy": {
        "additionalProperties": false,
        "properties": {
          "approver": {
            "const": "main",
            "default": "main",
            "title": "Approver",
            "type": "string"
          },
          "require_render": {
            "const": true,
            "default": true,
            "title": "Require Render",
            "type": "boolean"
          },
          "require_native_editability": {
            "default": true,
            "title": "Require Native Editability",
            "type": "boolean"
          },
          "max_revisions": {
            "default": 2,
            "maximum": 5,
            "minimum": 0,
            "title": "Max Revisions",
            "type": "integer"
          },
          "allow_paid_model": {
            "default": false,
            "title": "Allow Paid Model",
            "type": "boolean"
          }
        },
        "title": "ApprovalPolicy",
        "type": "object"
      },
      "DesignUnit": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "slide",
              "artboard",
              "graphic",
              "page",
              "spread",
              "composition",
              "glyph"
            ],
            "title": "Kind",
            "type": "string"
          },
          "width": {
            "maximum": 4096,
            "minimum": 64,
            "title": "Width",
            "type": "integer"
          },
          "height": {
            "maximum": 4096,
            "minimum": 64,
            "title": "Height",
            "type": "integer"
          },
          "instruction": {
            "maxLength": 12000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "source_slide": {
            "anyOf": [
              {
                "maximum": 200,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Slide"
          },
          "layout": {
            "anyOf": [
              {
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Layout"
          }
        },
        "required": [
          "id",
          "kind",
          "width",
          "height",
          "instruction"
        ],
        "title": "DesignUnit",
        "type": "object"
      },
      "EditorialContract": {
        "additionalProperties": false,
        "properties": {
          "margin": {
            "maximum": 500,
            "minimum": 0,
            "title": "Margin",
            "type": "number"
          },
          "columns": {
            "maximum": 12,
            "minimum": 1,
            "title": "Columns",
            "type": "integer"
          },
          "gutter": {
            "maximum": 200,
            "minimum": 0,
            "title": "Gutter",
            "type": "number"
          },
          "bleed": {
            "default": 0,
            "maximum": 100,
            "minimum": 0,
            "title": "Bleed",
            "type": "number"
          },
          "styles": {
            "items": {
              "$ref": "#/$defs/EditorialStyle"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Styles",
            "type": "array"
          }
        },
        "required": [
          "margin",
          "columns",
          "gutter",
          "styles"
        ],
        "title": "EditorialContract",
        "type": "object"
      },
      "EditorialStyle": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "font": {
            "enum": [
              "Arial",
              "Calibri",
              "Aptos",
              "Georgia",
              "Times New Roman",
              "Verdana"
            ],
            "title": "Font",
            "type": "string"
          },
          "size": {
            "maximum": 100,
            "minimum": 8,
            "title": "Size",
            "type": "number"
          },
          "leading": {
            "maximum": 180,
            "minimum": 8,
            "title": "Leading",
            "type": "number"
          },
          "color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "type": "string"
          },
          "bold": {
            "default": false,
            "title": "Bold",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "font",
          "size",
          "leading",
          "color"
        ],
        "title": "EditorialStyle",
        "type": "object"
      },
      "InputReference": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "path": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "role": {
            "enum": [
              "brief",
              "reference",
              "editable_source"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "role"
        ],
        "title": "InputReference",
        "type": "object"
      },
      "PresentationContract": {
        "additionalProperties": false,
        "properties": {
          "structure": {
            "enum": [
              "flat",
              "structured",
              "preserve"
            ],
            "title": "Structure",
            "type": "string"
          },
          "reusable_template": {
            "default": false,
            "title": "Reusable Template",
            "type": "boolean"
          },
          "title_size": {
            "maximum": 200,
            "minimum": 8,
            "title": "Title Size",
            "type": "number"
          },
          "body_size": {
            "maximum": 200,
            "minimum": 8,
            "title": "Body Size",
            "type": "number"
          },
          "title_font": {
            "enum": [
              "Arial",
              "Calibri",
              "Aptos",
              "Georgia",
              "Times New Roman",
              "Verdana"
            ],
            "title": "Title Font",
            "type": "string"
          },
          "body_font": {
            "enum": [
              "Arial",
              "Calibri",
              "Aptos",
              "Georgia",
              "Times New Roman",
              "Verdana"
            ],
            "title": "Body Font",
            "type": "string"
          },
          "background": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Background",
            "type": "string"
          },
          "foreground": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Foreground",
            "type": "string"
          },
          "accent": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Accent",
            "type": "string"
          }
        },
        "required": [
          "structure",
          "title_size",
          "body_size",
          "title_font",
          "body_font",
          "background",
          "foreground",
          "accent"
        ],
        "title": "PresentationContract",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "parent_request_id": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
        "title": "Parent Request Id",
        "type": "string"
      },
      "stage": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
        "title": "Stage",
        "type": "string"
      },
      "operation": {
        "enum": [
          "create",
          "edit",
          "refine",
          "assets",
          "render",
          "qa",
          "repair",
          "brainstorm",
          "prompt",
          "other"
        ],
        "title": "Operation",
        "type": "string"
      },
      "artifact_type": {
        "maxLength": 80,
        "minLength": 1,
        "title": "Artifact Type",
        "type": "string"
      },
      "units": {
        "items": {
          "$ref": "#/$defs/DesignUnit"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Units",
        "type": "array"
      },
      "inputs": {
        "items": {
          "$ref": "#/$defs/InputReference"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Inputs",
        "type": "array"
      },
      "output_format": {
        "maxLength": 20,
        "minLength": 1,
        "title": "Output Format",
        "type": "string"
      },
      "editability_requirements": {
        "items": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Editability Requirements",
        "type": "array"
      },
      "required_features": {
        "items": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 20,
        "title": "Required Features",
        "type": "array"
      },
      "allowed_tools": {
        "items": {
          "enum": [
            "read_input",
            "discover_capabilities",
            "write_unit",
            "build_artifact",
            "render_preview",
            "technical_qa"
          ],
          "type": "string"
        },
        "maxItems": 6,
        "minItems": 1,
        "title": "Allowed Tools",
        "type": "array"
      },
      "output_dir": {
        "maxLength": 1024,
        "minLength": 1,
        "title": "Output Dir",
        "type": "string"
      },
      "creative_constraints": {
        "maxLength": 20000,
        "minLength": 1,
        "title": "Creative Constraints",
        "type": "string"
      },
      "authorized": {
        "default": false,
        "title": "Authorized",
        "type": "boolean"
      },
      "no_execution": {
        "default": false,
        "title": "No Execution",
        "type": "boolean"
      },
      "revision": {
        "default": 0,
        "maximum": 5,
        "minimum": 0,
        "title": "Revision",
        "type": "integer"
      },
      "approval_policy": {
        "$ref": "#/$defs/ApprovalPolicy"
      },
      "timeout_seconds": {
        "default": 180,
        "maximum": 300,
        "minimum": 10,
        "title": "Timeout Seconds",
        "type": "integer"
      },
      "max_tool_calls": {
        "default": 48,
        "maximum": 80,
        "minimum": 3,
        "title": "Max Tool Calls",
        "type": "integer"
      },
      "presentation": {
        "anyOf": [
          {
            "$ref": "#/$defs/PresentationContract"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "editorial": {
        "anyOf": [
          {
            "$ref": "#/$defs/EditorialContract"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "parent_request_id",
      "stage",
      "operation",
      "artifact_type",
      "units",
      "inputs",
      "output_format",
      "editability_requirements",
      "allowed_tools",
      "output_dir",
      "creative_constraints"
    ],
    "title": "DesignTask",
    "type": "object"
  },

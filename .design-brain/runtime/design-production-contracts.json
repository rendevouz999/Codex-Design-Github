  "UnitContent": {
    "$defs": {
      "ChartData": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "column",
              "bar",
              "line",
              "pie"
            ],
            "title": "Type",
            "type": "string"
          },
          "categories": {
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Categories",
            "type": "array"
          },
          "series": {
            "items": {
              "$ref": "#/$defs/ChartSeries"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Series",
            "type": "array"
          }
        },
        "required": [
          "type",
          "categories",
          "series"
        ],
        "title": "ChartData",
        "type": "object"
      },
      "ChartSeries": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "name",
          "values"
        ],
        "title": "ChartSeries",
        "type": "object"
      },
      "Node": {
        "additionalProperties": false,
        "description": "Safe editable primitives; deliberately excludes executable markup and resource URLs.",
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "rect",
              "ellipse",
              "text",
              "line",
              "chart",
              "table",
              "text_frame"
            ],
            "title": "Kind",
            "type": "string"
          },
          "x": {
            "maximum": 4096,
            "minimum": 0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 4096,
            "minimum": 0,
            "title": "Y",
            "type": "number"
          },
          "width": {
            "exclusiveMinimum": 0,
            "maximum": 4096,
            "title": "Width",
            "type": "number"
          },
          "height": {
            "exclusiveMinimum": 0,
            "maximum": 4096,
            "title": "Height",
            "type": "number"
          },
          "fill": {
            "default": "#000000",
            "pattern": "^(#[0-9a-fA-F]{6}|none)$",
            "title": "Fill",
            "type": "string"
          },
          "stroke": {
            "default": "none",
            "pattern": "^(#[0-9a-fA-F]{6}|none)$",
            "title": "Stroke",
            "type": "string"
          },
          "stroke_width": {
            "default": 1,
            "maximum": 20,
            "minimum": 0,
            "title": "Stroke Width",
            "type": "number"
          },
          "radius": {
            "default": 0,
            "maximum": 200,
            "minimum": 0,
            "title": "Radius",
            "type": "number"
          },
          "text": {
            "default": "",
            "maxLength": 2000,
            "title": "Text",
            "type": "string"
          },
          "font": {
            "default": "Arial",
            "enum": [
              "Arial",
              "Calibri",
              "Aptos",
              "Georgia",
              "Times New Roman",
              "Verdana"
            ],
            "title": "Font",
            "type": "string"
          },
          "font_size": {
            "default": 24,
